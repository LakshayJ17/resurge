<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Resurge">
<meta name="color-scheme" content="light dark">
<meta name="description" content="{{ es.headline or title }}">
<title>{{ title }}</title>
<style>
/* One system: white page, ink text, serif headings, one blue accent, faint hairlines. Separation comes from
   space and soft tints, never from heavy borders. */
:root {
  color-scheme: light;
  --bg: #ffffff; --paper: #f7f6f2; --ink: #1c1b18; --ink-2: #3d3b36; --muted: #6b6862;
  --rule: rgba(28, 27, 24, .08); --rule-2: rgba(28, 27, 24, .14); --tint: rgba(28, 27, 24, .035);
  --accent: #1f4e8c; --accent-tint: rgba(31, 78, 140, .07);
  --good: #2f6b3a; --good-tint: rgba(47, 107, 58, .09);
  --warn: #8a5a00; --warn-tint: rgba(184, 124, 0, .11);
  --bad: #9b2c2c; --bad-tint: rgba(155, 44, 44, .08);
  --serif: "Iowan Old Style", "Charter", "Sitka Text", Cambria, Georgia, "Times New Roman", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --radius: 12px;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --bg: #151514; --paper: #1d1d1b; --ink: #ecebe6; --ink-2: #cfcdc6; --muted: #9e9b93;
    --rule: rgba(236, 235, 230, .09); --rule-2: rgba(236, 235, 230, .16); --tint: rgba(236, 235, 230, .05);
    --accent: #8fb5e8; --accent-tint: rgba(143, 181, 232, .1);
    --good: #8fd19e; --good-tint: rgba(143, 209, 158, .1);
    --warn: #e3b25e; --warn-tint: rgba(227, 178, 94, .12);
    --bad: #f0a0a0; --bad-tint: rgba(240, 160, 160, .1);
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 24px; -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; }
a { color: var(--accent); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px;
  text-decoration-thickness: 1px; transition: text-decoration-color .2s ease, color .2s ease; }
a:hover { text-decoration-color: currentColor; }
a:focus-visible, summary:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
h1, h2, h3, h4 { margin: 0; color: var(--ink); }
h2 { font: 600 30px/1.2 var(--serif); letter-spacing: -.01em; }
h3 { font: 600 17px/1.4 var(--sans); margin: 32px 0 12px; }
h4 { font: 600 14px/1.4 var(--sans); margin: 0 0 8px; }
p { margin: 0 0 14px; }
ul, ol { margin: 0 0 14px; padding-left: 20px; }
li { margin: 0 0 6px; }
.muted { color: var(--muted); }
.small { font-size: 14px; }
.nowrap { white-space: nowrap; }
.measure { max-width: 70ch; }
.skip { position: absolute; left: -9999px; }
.skip:focus { left: 16px; top: 16px; background: var(--bg); padding: 8px 12px; z-index: 10; }

/* frame */
.wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
header.top { padding: 72px 0 56px; }
.kicker { margin: 0 0 14px; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
header.top h1 { font: 600 52px/1.08 var(--serif); letter-spacing: -.015em; max-width: 20ch; }
.compared { margin: 14px 0 0; font-size: 19px; color: var(--ink-2); }
.headline { margin: 28px 0 0; max-width: 62ch; font: italic 400 22px/1.45 var(--serif); color: var(--ink); }
.meta { margin: 22px 0 0; font-size: 14px; color: var(--muted); }
.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 40px; margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--rule); }
.kpi b { display: block; font: 600 34px/1.1 var(--sans); letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
.kpi span { display: block; margin-top: 6px; font-size: 14px; color: var(--muted); }

.layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 64px; padding-bottom: 80px; }
.toc { position: sticky; top: 24px; align-self: start; padding-top: 52px; font-size: 14px; }
.toc p { margin: 0 0 10px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.toc ol { list-style: none; padding: 0; margin: 0; }
.toc li { margin: 0; }
.toc a { display: block; padding: 5px 0; color: var(--ink-2); }
.toc a:hover { color: var(--ink); }
main { min-width: 0; }
section { padding: 52px 0 8px; }
section + section { border-top: 1px solid var(--rule); margin-top: 44px; }
.eyebrow { margin: 0 0 8px; font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
section > h2 { margin-bottom: 22px; }
.lede { font-size: 18px; line-height: 1.6; color: var(--ink-2); max-width: 70ch; }

/* lists of findings */
.insights { list-style: none; padding: 0; margin: 0 0 14px; }
.insights li { position: relative; padding: 10px 0 10px 22px; margin: 0; border-bottom: 1px solid var(--rule); }
.insights li:last-child { border-bottom: 0; }
.insights li::before { content: ""; position: absolute; left: 2px; top: 20px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); opacity: .7; }
.insights li.is-inferred::before { background: transparent; box-shadow: inset 0 0 0 1.5px var(--muted); opacity: 1; }
ol.findings { list-style: none; counter-reset: f; padding: 0; margin: 0 0 8px; }
ol.findings li { counter-increment: f; display: grid; grid-template-columns: 36px minmax(0, 1fr); padding: 14px 0; margin: 0; border-bottom: 1px solid var(--rule); }
ol.findings li:last-child { border-bottom: 0; }
ol.findings li::before { content: counter(f); font: 600 18px/1.4 var(--serif); color: var(--accent); }
.so-what { display: block; margin-top: 4px; font-size: 15px; color: var(--ink-2); }
.so-what b { color: var(--ink); font-weight: 600; }
.conf { margin-left: 6px; font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.conf.low { color: var(--warn); }
.tag-inferred { display: inline-block; margin-right: 6px; font-size: 12px; font-style: italic; color: var(--muted); }
.cites { font-size: 11px; line-height: 0; margin-left: 2px; white-space: nowrap; }
.cite { padding: 0 1px; font-weight: 600; }

/* soft panels: tint, no border */
.pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 24px 0 8px; }
.panel { background: var(--paper); border-radius: var(--radius); padding: 22px 24px; min-width: 0; }
.panel ul:last-child, .panel p:last-child { margin-bottom: 0; }
.label { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.label::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--muted)); }
.c-good { --c: var(--good); } .c-bad { --c: var(--bad); } .c-warn { --c: var(--warn); } .c-accent { --c: var(--accent); }

/* by the numbers */
.numbers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
.num-tile { padding: 18px 0 22px; border-top: 1px solid var(--rule-2); }
.num-tile:nth-child(-n+3) { border-top-color: var(--accent); border-top-width: 2px; }
.num-tile p { margin: 0; }
.num-v { font: 600 30px/1.15 var(--sans); letter-spacing: -.01em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.num-l { margin-top: 6px !important; font-weight: 600; }
.num-d { margin-top: 2px !important; font-size: 14px; color: var(--muted); }

/* tables: quiet header, hairline rows, no outer box */
.table-wrap { overflow-x: auto; margin: 8px 0 18px; }
table { border-collapse: collapse; width: 100%; font-size: 15px; }
th, td { text-align: left; vertical-align: top; padding: 12px 18px 12px 0; border-bottom: 1px solid var(--rule); }
th:last-child, td:last-child { padding-right: 0; }
thead th { font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); border-bottom-color: var(--rule-2); padding-top: 0; }
tbody tr { transition: background-color .15s ease; }
tbody tr:hover { background: var(--tint); }
tbody th { font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
td.co { width: 22%; min-width: 150px; }
.sub { display: block; margin-top: 3px; font-size: 14px; color: var(--muted); }
.dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--c, var(--muted)); margin-right: 8px; vertical-align: .05em; }

/* soft status pills */
.chip { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; background: var(--tint); color: var(--ink-2); }
.st-supported, .fm-yes, .band-Low, .verdict-pass, .prio-low, .t1, .t2 { background: var(--good-tint); color: var(--good); }
.st-partial, .fm-partial, .band-Medium, .verdict-revise, .prio-medium, .t3 { background: var(--warn-tint); color: var(--warn); }
.st-unsupported, .st-contradicted, .st-rejected, .fm-no, .band-High, .band-Critical, .verdict-fail, .prio-high, .t4, .t5 { background: var(--bad-tint); color: var(--bad); }
.st-pending, .fm-unknown { background: var(--tint); color: var(--muted); }
.matrix td { font-size: 14px; }
.matrix .fm-note { display: block; margin-top: 4px; font-size: 12.5px; color: var(--muted); font-weight: 400; }

/* drawn graphics: bars, pips and splits in the page's own colours */
.bar { position: relative; height: 7px; border-radius: 99px; background: var(--tint); overflow: hidden; min-width: 90px; }
.bar > span { position: absolute; top: 0; bottom: 0; left: 0; border-radius: inherit; background: var(--accent); }
.bar > span.part { background: var(--warn); opacity: .55; }
.bar-label { display: block; margin-top: 5px; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.pips { display: inline-flex; gap: 3px; vertical-align: middle; }
.pips i { width: 13px; height: 7px; border-radius: 3px; background: var(--rule-2); }
.lvl-1 .on, .lvl-2 .on { background: var(--good); } .lvl-3 .on { background: var(--warn); } .lvl-4 .on, .lvl-5 .on { background: var(--bad); }
.duo { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; width: 130px; }
.duo .left, .duo .right { position: relative; height: 7px; border-radius: 99px; background: var(--tint); overflow: hidden; }
.duo .left > span { position: absolute; right: 0; top: 0; bottom: 0; background: var(--bad); border-radius: inherit; opacity: .8; }
.duo .right > span { position: absolute; left: 0; top: 0; bottom: 0; background: var(--good); border-radius: inherit; opacity: .8; }
table.scorecard td { vertical-align: middle; }
table.scorecard td.metric { min-width: 120px; }
.strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 20px 0 8px; padding: 18px 20px; background: var(--paper); border-radius: var(--radius); }
.strip h4 { font-size: 12.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
.strip .big { display: block; font: 600 22px/1.2 var(--sans); font-variant-numeric: tabular-nums; margin-bottom: 6px; }
.topics { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 32px; }
.topics li { margin: 0; display: grid; grid-template-columns: 150px minmax(0, 1fr) 28px; gap: 12px; align-items: center; font-size: 14px; }
.topics .n { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
.split { display: flex; height: 10px; border-radius: 99px; overflow: hidden; gap: 2px; margin: 6px 0 10px; }
.split > span { display: block; height: 100%; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0 0 18px; font-size: 14px; color: var(--ink-2); }
.legend span::before { content: ""; display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 7px; background: var(--c); vertical-align: .02em; }
.k-official { --c: var(--accent); } .k-news { --c: #4f7cc0; } .k-review { --c: var(--good); } .k-community { --c: var(--warn); }
.k-reference { --c: #8a7f6d; } .k-code { --c: #5c6670; } .k-social { --c: #b5658b; } .k-other { --c: var(--rule-2); }
.k-supported { --c: var(--good); } .k-partial { --c: var(--warn); } .k-failed { --c: var(--bad); } .k-pending { --c: var(--rule-2); }
.split > span { background: var(--c); }
.balance { display: flex; height: 8px; border-radius: 99px; overflow: hidden; gap: 3px; margin: 14px 0 6px; max-width: 520px; }
.balance .they { background: var(--bad); opacity: .75; } .balance .we { background: var(--good); opacity: .75; }
.balance-label { display: flex; justify-content: space-between; max-width: 520px; font-size: 14px; color: var(--muted); }
.h2h { padding: 26px 0; }
.h2h + .h2h { border-top: 1px solid var(--rule); }
.h2h h3 { margin: 0 0 8px; font: 600 21px/1.3 var(--serif); }
.lanes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 12px 0 24px; align-items: start; }
.lane { background: var(--paper); border-radius: var(--radius); padding: 16px 16px 6px; min-width: 0; }
.lane > p { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
.lane > p b { display: block; font: 600 18px/1.3 var(--serif); color: var(--ink); }
.action { background: var(--bg); border-radius: 10px; padding: 14px 16px; margin: 0 0 10px; box-shadow: 0 1px 2px rgba(28, 27, 24, .05); }
.action .no { font: 600 15px/1 var(--serif); color: var(--accent); margin-right: 6px; }
.action strong { font-size: 15px; }
.action .meta-line { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin-top: 10px; font-size: 13px; color: var(--muted); }
.lane .empty { font-size: 14px; color: var(--muted); padding: 4px 0 12px; }
.pipeline { list-style: none; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); gap: 0; padding: 0; margin: 8px 0 28px; }
.pipeline li { position: relative; margin: 0; padding: 16px 18px 16px 0; }
.pipeline li + li { padding-left: 22px; }
.pipeline li + li::before { content: ""; position: absolute; left: 0; top: 30px; width: 8px; height: 8px; border-top: 1.5px solid var(--muted); border-right: 1.5px solid var(--muted); transform: rotate(45deg); }
.pipeline b { display: block; font: 600 28px/1.15 var(--sans); font-variant-numeric: tabular-nums; }
.pipeline span { display: block; margin-top: 4px; font-size: 14px; color: var(--ink-2); }
.pipeline li:last-child b { color: var(--accent); }

/* charts: the picture alone, no frame */
figure.chart { margin: 20px 0 28px; }
figure.chart img { display: block; width: 100%; max-width: 900px; height: auto; border-radius: 6px; }

/* competitor deep dives */
details.profile { border-top: 1px solid var(--rule); }
details.profile:last-of-type { border-bottom: 1px solid var(--rule); }
details.profile > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 18px 8px; margin: 0 -8px; border-radius: 8px; transition: background-color .15s ease; }
details.profile > summary:hover { background: var(--tint); }
details.profile > summary::-webkit-details-marker { display: none; }
details.profile > summary .name { font: 600 21px/1.3 var(--serif); }
details.profile > summary::after { content: ""; margin-left: auto; width: 8px; height: 8px; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(45deg); transition: transform .2s ease; }
details.profile[open] > summary::after { transform: rotate(225deg); }
details.profile > .body { padding: 4px 0 28px; }
dl.facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px 32px; margin: 18px 0 8px; }
dl.facts dt { font-size: 12.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
dl.facts dd { margin: 2px 0 0; font-weight: 600; overflow-wrap: anywhere; }
.cols-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin: 20px 0 4px; }
.cols-3 ul { padding-left: 18px; font-size: 15px; }
blockquote { margin: 8px 0 0; padding: 0 0 0 14px; box-shadow: inset 2px 0 0 var(--rule-2); color: var(--ink-2); font-style: italic; }

/* method */
.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0 32px; margin: 4px 0 18px; }
.tile { padding: 14px 0 16px; border-top: 1px solid var(--rule-2); }
.tile b { display: block; font: 600 24px/1.2 var(--sans); font-variant-numeric: tabular-nums; }
.tile span { display: block; margin-top: 2px; font-size: 14px; color: var(--ink-2); }
.tile small { display: block; font-size: 12.5px; color: var(--muted); }
.org { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
.dept { background: var(--paper); border-radius: var(--radius); padding: 18px 20px; }
.dept h4 { margin-bottom: 10px; font-size: 12.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
.agent { padding: 8px 0; }
.agent + .agent { border-top: 1px solid var(--rule); }
.agent p { margin: 2px 0 4px; font-size: 13.5px; color: var(--ink-2); }
.model { display: inline-block; margin: 2px 4px 0 0; padding: 1px 7px; border-radius: 6px; background: var(--tint); font: 12px/1.6 var(--mono); color: var(--ink-2); overflow-wrap: anywhere; }

/* evidence */
.fact-row:target { background: var(--accent-tint); }
.fact-no { font: 600 15px/1.4 var(--serif); color: var(--accent); }
.fact-id { display: block; font: 12px/1.6 var(--mono); color: var(--muted); }
.filter { display: flex; gap: 12px; align-items: center; margin: 8px 0 16px; }
.filter input { flex: 1; max-width: 440px; padding: 10px 14px; border: 0; border-radius: 10px; background: var(--paper); color: var(--ink); font: inherit; box-shadow: inset 0 0 0 1px var(--rule); transition: box-shadow .15s ease; }
.filter input:focus { box-shadow: inset 0 0 0 1.5px var(--accent); outline: none; }
.src-links { min-width: 170px; }
.src-links a { display: inline-block; margin-right: 10px; overflow-wrap: anywhere; }

footer.page { padding: 28px 0 48px; border-top: 1px solid var(--rule); font-size: 14px; color: var(--muted); }

@media (prefers-color-scheme: dark) {
  figure.chart img { background: #fff; padding: 10px; border-radius: var(--radius); }
}
@media (max-width: 1080px) {
  .layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .toc { position: static; padding-top: 8px; }
  .toc ol { display: flex; flex-wrap: wrap; gap: 2px 18px; }
}
@media (max-width: 760px) {
  .wrap { padding: 0 18px; }
  header.top { padding: 44px 0 36px; }
  header.top h1 { font-size: 38px; }
  .headline { font-size: 19px; }
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .pair, .cols-3, .lanes, .topics { grid-template-columns: minmax(0, 1fr); }
  .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pipeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pipeline li + li::before { display: none; }
  .pipeline li + li { padding-left: 0; }
  h2 { font-size: 26px; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { transition: none !important; }
}
@media print {
  :root { --bg: #fff; --paper: #f7f6f2; }
  body { font-size: 10.5pt; }
  .toc, .filter, .skip { display: none !important; }
  .layout { display: block; padding: 0; }
  header.top { padding: 0 0 24px; }
  section { padding-top: 24px; }
  h2, h3, figure, tr, .panel, .num-tile, .tile, .dept { break-inside: avoid; }
  details.profile > summary::after { display: none; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
</head>
{% macro cite(ids) -%}
{% set seen = [] %}
{% for fid in ids if fid in facts and fid not in seen %}{% set _ = seen.append(fid) %}{% endfor %}
{% if seen %}<sup class="cites">{% for fid in seen[:6] %}<a class="cite" href="#{{ fid | anchor }}" title="{{ facts[fid].claim | clip(160) }}">{{ cite_no.get(fid, "") }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if seen | length > 6 %} +{{ seen | length - 6 }}{% endif %}</sup>{% endif %}
{%- endmacro %}
{% macro ext_link(url, label, cls="", title="") -%}
{% set href = url | url %}
{% if href %}<a{% if cls %} class="{{ cls }}"{% endif %} href="{{ href }}" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" target="_blank"{% if title %} title="{{ title }}"{% endif %}>{{ label }}</a>{% else %}{{ label }}{% endif %}
{%- endmacro %}
{% macro conf(value) -%}
{% if value is not none %}<span class="conf{{ ' low' if value < 0.6 else '' }}" title="Confidence">{{ value | pct }}</span>{% endif %}
{%- endmacro %}
{% macro insight_list(items, empty="Nothing reported.") -%}
{% if items %}
<ul class="insights">
{% for i in items %}
<li class="{{ 'is-inferred' if i.inferred else 'is-backed' }}">{% if i.inferred %}<span class="tag-inferred" title="Analyst judgement, not a direct fact">Inferred</span>{% endif %}{{ i.text }}{{ cite(i.fact_ids) }}{{ conf(confidence(i)) }}</li>
{% endfor %}
</ul>
{% else %}
<p class="muted">{{ empty }}</p>
{% endif %}
{%- endmacro %}
{% macro plain_list(items, empty="Nothing reported.") -%}
{% if items %}<ul>{% for item in items %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<p class="muted">{{ empty }}</p>{% endif %}
{%- endmacro %}
{% macro chart(name) -%}
{% if name in charts %}<figure class="chart" id="chart-{{ name }}"><img src="{{ charts[name] }}" alt="{{ chart_titles[name] }}"></figure>{% endif %}
{%- endmacro %}
{% macro pips(level) -%}
{% if level %}<span class="pips lvl-{{ level }}" title="Threat {{ level }} of 5">{% for k in range(5) %}<i class="{{ 'on' if k < level else '' }}"></i>{% endfor %}</span>{% endif %}
{%- endmacro %}
{% macro duo(row) -%}
<div class="duo" title="{{ row.complaints }} complaints, {{ row.praise }} praise"><span class="left"><span style="width: {{ row.complaints_pct }}%"></span></span><span class="right"><span style="width: {{ row.praise_pct }}%"></span></span></div>
{%- endmacro %}
{% macro split(parts) -%}
<div class="split" aria-hidden="true">{% for key, label, n, share in parts %}<span class="k-{{ key }}" style="width: {{ share }}%"></span>{% endfor %}</div>
<p class="legend">{% for key, label, n, share in parts %}<span class="k-{{ key }}">{{ label }} {{ n }}</span>{% endfor %}</p>
{%- endmacro %}
{% macro threat(level) -%}
{% set t = [[level, 1] | max, 5] | min %}<span class="chip t{{ t }}">{{ t }} of 5 ({{ t | threat_label }})</span>
{%- endmacro %}
<body>
<a class="skip" href="#summary">Skip to the summary</a>
<div class="wrap">
<header class="top">
  <p class="kicker">Competitor report, {{ date }}</p>
  <h1>{{ target }}</h1>
  {% if compared %}<p class="compared">Compared with {{ compared }}</p>{% endif %}
  {% if es.headline %}<p class="headline">{{ es.headline }}</p>{% endif %}
  <p class="meta">{% if r.brief.industry %}{{ r.brief.industry }}, {% endif %}{{ r.brief.depth.value | title }} research, run {{ r.run_id }}</p>
  <div class="kpis">
    {% for m in hero_metrics %}<div class="kpi"><b>{{ m.display }}</b><span>{{ m.label }}</span></div>{% endfor %}
  </div>
</header>

<div class="layout">
<nav class="toc" aria-label="Contents">
  <p>Contents</p>
  <ol>{% for key, label in toc %}<li><a href="#{{ key }}">{{ label }}</a></li>{% endfor %}</ol>
</nav>
<main>

<section id="summary">
  <p class="eyebrow">Summary</p>
  <h2>What the research found</h2>
  {% for para in (es.summary or "").split("\n\n") if para.strip() %}<p class="lede">{{ para }}</p>{% endfor %}
  {% if es.key_findings %}
  <h3>Key findings</h3>
  <ol class="findings">
    {% for k in es.key_findings %}
    <li><div>{% if k.inferred %}<span class="tag-inferred">Inferred</span>{% endif %}{{ k.text }}{{ cite(k.fact_ids) }}{{ conf(confidence(k)) }}{% if k.so_what %}<span class="so-what"><b>So what:</b> {{ k.so_what }}</span>{% endif %}</div></li>
    {% endfor %}
  </ol>
  {% endif %}
  {% if es.top_threats or es.top_opportunities %}
  <div class="pair">
    {% if es.top_threats %}<div class="panel"><p class="label c-bad">Top threats</p>{{ plain_list(es.top_threats) }}</div>{% endif %}
    {% if es.top_opportunities %}<div class="panel"><p class="label c-good">Top opportunities</p>{{ plain_list(es.top_opportunities) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if es.answers %}
  <h3>Answers to your questions</h3>
  {% for a in es.answers %}
  <p class="measure"><strong>{{ a.question }}</strong><br>{{ a.answer }}{{ cite(a.fact_ids) }}{% if not a.answered %} <span class="muted small">(not answered by the research)</span>{% endif %}</p>
  {% endfor %}
  {% endif %}
  {% if es.scope %}<p class="muted small measure"><strong>Scope.</strong> {{ es.scope }}</p>{% endif %}
  {% if not (es.headline or es.summary or es.key_findings or es.top_threats or es.top_opportunities) %}<p class="muted">No executive summary was produced for this run.</p>{% endif %}
</section>

{% if show.numbers %}
<section id="numbers">
  <p class="eyebrow">At a glance</p>
  <h2>By the numbers</h2>
  <div class="numbers">
    {% for st in numbers %}
    <div class="num-tile"><p class="num-v">{{ st.value }}</p><p class="num-l">{{ st.label }}</p>{% if st.detail %}<p class="num-d">{{ st.detail }}</p>{% endif %}</div>
    {% endfor %}
  </div>
  {% if scorecard %}
  <h3>Company scorecard</h3>
  <div class="table-wrap"><table class="scorecard">
    <thead><tr><th>Company</th><th>Threat</th><th>Capabilities</th><th>Cheapest plan</th><th>Evidence</th><th>Complaints / praise</th><th>Latest move</th></tr></thead>
    <tbody>
    {% for row in scorecard %}
      <tr>
        <td class="co"><span class="dot" style="--c: {{ row.color }}"></span><a href="#{{ row.anchor }}"><strong>{{ row.name }}</strong></a>{% if row.is_target %}<span class="sub">The client</span>{% endif %}</td>
        <td>{% if row.threat %}{{ pips(row.threat) }}<span class="bar-label">{{ row.threat }} of 5</span>{% else %}<span class="muted">-</span>{% endif %}</td>
        <td class="metric">{% if row.caps is not none %}<div class="bar"><span class="part" style="width: {{ row.caps_pct + row.caps_partial_pct }}%"></span><span style="width: {{ row.caps_pct }}%"></span></div><span class="bar-label">{{ row.caps }} of {{ row.caps_total }}{% if row.caps_partial %}, {{ row.caps_partial }} partly{% endif %}</span>{% else %}<span class="muted">-</span>{% endif %}</td>
        <td class="nowrap">{{ row.cheapest or "-" }}</td>
        <td class="metric"><div class="bar"><span style="width: {{ row.facts_pct }}%"></span></div><span class="bar-label">{{ row.facts }} verified facts</span></td>
        <td>{% if row.praise or row.complaints %}{{ duo(row) }}<span class="bar-label">{{ row.complaints }} / {{ row.praise }}</span>{% else %}<span class="muted">-</span>{% endif %}</td>
        <td class="nowrap">{{ row.latest or "-" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}
</section>
{% endif %}

{% if show.landscape %}
<section id="landscape">
  <p class="eyebrow">Market map</p>
  <h2>Competitive landscape</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Competitor</th><th>Type</th><th>What they are</th><th>Threat</th></tr></thead>
    <tbody>
    {% for c in landscape %}
      <tr>
        <td class="co"><span class="dot" style="--c: {{ c.color }}"></span>{% if c.has_profile %}<a href="#{{ c.anchor }}"><strong>{{ display(c.name) }}</strong></a>{% else %}<strong>{{ display(c.name) }}</strong>{% endif %}{% if c.website %}<span class="sub">{{ ext_link(c.website, c.website | domain) }}</span>{% endif %}</td>
        <td>{{ c.category or "-" }}</td>
        <td>{{ c.summary or "-" }}</td>
        <td class="nowrap">{% if c.threat %}{{ threat(c.threat) }}{% else %}<span class="muted">Not rated</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {{ chart("threat_levels") }}
</section>
{% endif %}

{% if show.features %}
<section id="features">
  <p class="eyebrow">Product</p>
  <h2>Feature comparison</h2>
  {{ chart("feature_breadth") }}
  <div class="table-wrap"><table class="matrix">
    <thead><tr><th>Capability</th>{% for c in matrix.companies %}<th class="nowrap"><span class="dot" style="--c: {{ color(c) }}"></span>{{ display(c) }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in matrix.rows %}
      <tr><th scope="row">{{ row.feature }}</th>{% for cell in row.cells %}<td><span class="chip fm-{{ cell.status }}"><span aria-hidden="true">{{ cell.glyph }}</span> {{ cell.label }}</span>{{ cite(cell.fact_ids) }}{% if cell.note %}<span class="fm-note">{{ cell.note }}</span>{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="muted small">"Unknown" means the research found no public evidence either way. It never counts as a "no".</p>
</section>
{% endif %}

{% if show.pricing %}
<section id="pricing">
  <p class="eyebrow">Pricing</p>
  <h2>What each plan costs</h2>
  {{ chart("pricing") }}
  <div class="table-wrap"><table>
    <thead><tr><th>Company</th><th>Plan</th><th>Price</th><th>Billing</th><th>What it includes</th></tr></thead>
    <tbody>
    {% for item in profiles if item.p.pricing %}
      {% for t in item.p.pricing %}
      <tr>
        {% if loop.first %}<td rowspan="{{ item.p.pricing | length }}" class="co"><span class="nowrap"><span class="dot" style="--c: {{ item.color }}"></span><strong>{{ display(item.p.name) }}</strong></span>{% if item.p.pricing_model %}<span class="sub">{{ item.p.pricing_model }}</span>{% endif %}</td>{% endif %}
        <td>{{ t.name }}</td>
        <td>{% set shown = t.price | price %}<span{% if shown == "Not listed" %} class="muted"{% endif %}>{{ shown }}</span>{% if t.price_monthly_usd is not none and (t.price_monthly_usd | usd) not in shown %}<span class="sub nowrap">about {{ t.price_monthly_usd | usd }} a month</span>{% endif %}</td>
        <td>{{ t.billing or "" }}</td>
        <td>{{ t.highlights | join("; ") }}{{ cite(t.fact_ids) }}</td>
      </tr>
      {% endfor %}
    {% endfor %}
    </tbody>
  </table></div>
  {{ chart("cost_curve") }}
</section>
{% endif %}

{% if show.positioning %}
<section id="positioning">
  <p class="eyebrow">Positioning</p>
  <h2>Where each company sits</h2>
  {{ chart("positioning") }}
  <div class="table-wrap"><table>
    <thead><tr><th>Company</th><th class="num">{{ r.positioning.x_axis }}</th><th class="num">{{ r.positioning.y_axis }}</th><th>Why</th></tr></thead>
    <tbody>
    {% for p in r.positioning.points %}
      <tr><td class="nowrap"><span class="dot" style="--c: {{ color(p.competitor) }}"></span>{% if p.is_target %}<strong>{{ display(p.competitor) }}</strong>{% else %}{{ display(p.competitor) }}{% endif %}</td><td class="num">{{ "%.0f" | format(p.x) }}</td><td class="num">{{ "%.0f" | format(p.y) }}</td><td>{{ p.rationale }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endif %}

{% if show.profiles %}
<section id="profiles">
  <p class="eyebrow">Deep dives</p>
  <h2>The companies, one by one</h2>
  {{ chart("voice") }}
  {% for item in profiles %}
  {% set p = item.p %}
  <details class="profile" id="{{ item.anchor }}"{% if loop.first %} open{% endif %}>
    <summary><span class="dot" style="--c: {{ item.color }}"></span><span class="name">{{ display(p.name) }}</span>{% if p.category %}<span class="chip">{{ p.category | title }}</span>{% endif %}{% if p.threat_level is not none %}{{ threat(p.threat_level) }}{% endif %}</summary>
    <div class="body">
      {% if p.summary %}<p class="lede">{{ p.summary }}</p>{% endif %}
      {% if p.threat_rationale %}<p class="small muted measure"><strong>Why this threat level:</strong> {{ p.threat_rationale }}</p>{% endif %}
      <dl class="facts">
        {% if p.website and (p.website | url) %}<div><dt>Website</dt><dd>{{ ext_link(p.website, p.website | domain) }}</dd></div>{% endif %}
        {% if p.founded %}<div><dt>Founded</dt><dd>{{ p.founded }}</dd></div>{% endif %}
        {% if p.headquarters %}<div><dt>Headquarters</dt><dd>{{ p.headquarters }}</dd></div>{% endif %}
        {% if p.headcount %}<div><dt>Size</dt><dd>{{ p.headcount }}</dd></div>{% endif %}
        {% if p.funding %}<div><dt>Funding</dt><dd>{{ p.funding }}</dd></div>{% endif %}
        {% if p.pricing_model %}<div><dt>Pricing model</dt><dd>{{ p.pricing_model }}</dd></div>{% endif %}
        {% if p.sentiment_score is not none %}<div><dt>Customer sentiment</dt><dd>{{ "%+.1f" | format(p.sentiment_score) }} <span class="muted small">on −1 to +1</span></dd></div>{% endif %}
      </dl>
      {% set sc = scorecard | selectattr("anchor", "equalto", item.anchor) | first %}
      {% if sc %}
      <div class="strip">
        <div><h4>Threat</h4>{% if sc.threat %}<span class="big">{{ sc.threat }} of 5</span>{{ pips(sc.threat) }}{% else %}<span class="big muted">-</span>{% endif %}</div>
        <div><h4>Capabilities</h4>{% if sc.caps is not none %}<span class="big">{{ sc.caps }} of {{ sc.caps_total }}</span><div class="bar"><span class="part" style="width: {{ sc.caps_pct + sc.caps_partial_pct }}%"></span><span style="width: {{ sc.caps_pct }}%"></span></div>{% else %}<span class="big muted">-</span>{% endif %}</div>
        <div><h4>Evidence</h4><span class="big">{{ sc.facts }} facts</span><div class="bar"><span style="width: {{ sc.facts_pct }}%"></span></div></div>
        <div><h4>Complaints / praise</h4>{% if sc.praise or sc.complaints %}<span class="big">{{ sc.complaints }} / {{ sc.praise }}</span>{{ duo(sc) }}{% else %}<span class="big muted">-</span>{% endif %}</div>
      </div>
      {% if sc.topics %}
      <h4 style="margin-top:20px">What the evidence covers</h4>
      <ul class="topics">{% for topic, n, share in sc.topics %}<li><span>{{ topic }}</span><span class="bar"><span style="width: {{ share }}%"></span></span><span class="n">{{ n }}</span></li>{% endfor %}</ul>
      {% endif %}
      {% endif %}
      <div class="cols-3">
        <div><h4>Customers</h4>{{ plain_list(p.target_customers) }}</div>
        <div><h4>Products</h4>{{ plain_list(p.products) }}</div>
        <div><h4>Key features</h4>{{ plain_list(p.key_features) }}</div>
      </div>
      <div class="pair">
        <div class="panel"><p class="label c-good">Strengths</p>{{ insight_list(p.strengths) }}</div>
        <div class="panel"><p class="label c-bad">Weaknesses</p>{{ insight_list(p.weaknesses) }}</div>
      </div>
      {% if p.customer_praise or p.customer_complaints %}
      <div class="pair">
        <div><h4>What customers praise</h4>{{ insight_list(p.customer_praise) }}</div>
        <div><h4>What customers complain about</h4>{{ insight_list(p.customer_complaints) }}</div>
      </div>
      {% endif %}
      {% if p.recent_moves %}<h4 style="margin-top:20px">Recent moves</h4>{{ insight_list(p.recent_moves) }}{% endif %}
    </div>
  </details>
  {% endfor %}
</section>
{% endif %}

{% if show.headtohead %}
<section id="headtohead">
  <p class="eyebrow">Head to head</p>
  <h2>{{ target }} against each competitor</h2>
  {% for row in head_to_head %}
  <div class="h2h">
    <h3><span class="dot" style="--c: {{ row.color }}"></span>{{ row.name }}</h3>
    {% if row.h.verdict %}<p class="lede measure">{{ row.h.verdict }}</p>{% endif %}
    {% if row.they or row.we %}
    <div class="balance" aria-hidden="true"><span class="they" style="width: {{ row.they_pct }}%"></span><span class="we" style="flex: 1"></span></div>
    <p class="balance-label"><span>Buyers pick {{ row.name }}: {{ row.they }} reason{{ "s" if row.they != 1 else "" }}</span><span>Buyers pick {{ target }}: {{ row.we }}</span></p>
    {% endif %}
    <div class="pair">
      <div class="panel"><p class="label c-bad">Why buyers pick {{ row.name }}</p>{{ insight_list(row.h.they_win) }}</div>
      <div class="panel"><p class="label c-good">Why buyers pick {{ target }}</p>{{ insight_list(row.h.we_win) }}</div>
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if show.swot %}
<section id="swot">
  <p class="eyebrow">SWOT</p>
  <h2>Strengths, weaknesses, opportunities, threats</h2>
  {% for s in r.swots %}
  <h3><span class="dot" style="--c: {{ color(s.subject) }}"></span>{{ display(s.subject) }}</h3>
  <div class="pair">
    <div class="panel"><p class="label c-good">Strengths</p>{{ insight_list(s.strengths) }}</div>
    <div class="panel"><p class="label c-bad">Weaknesses</p>{{ insight_list(s.weaknesses) }}</div>
    <div class="panel"><p class="label c-accent">Opportunities</p>{{ insight_list(s.opportunities) }}</div>
    <div class="panel"><p class="label c-warn">Threats</p>{{ insight_list(s.threats) }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if show.market %}
<section id="market">
  <p class="eyebrow">Market</p>
  <h2>How the market is moving</h2>
  {% for para in (r.market.summary or "").split("\n\n") if para.strip() %}<p class="lede">{{ para }}</p>{% endfor %}
  {% if r.market.trends %}<h3>Trends</h3>{{ insight_list(r.market.trends) }}{% endif %}
  {{ chart("timeline") }}
  {% if r.market.five_forces %}
  <h3>Competitive forces</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>Force</th><th>Strength</th><th>Why</th></tr></thead>
    <tbody>
    {% for f in r.market.five_forces %}
      {% set rating = [[f.rating, 1] | max, 5] | min %}
      <tr><td><strong>{{ f.force }}</strong></td><td class="nowrap">{{ rating }} of 5</td><td>{{ f.rationale }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}
</section>
{% endif %}

{% if show.recommendations %}
<section id="recommendations">
  <p class="eyebrow">Action plan</p>
  <h2>What to do next</h2>
  {% if recommendations %}
  <div class="lanes">
    {% for lane in lanes %}
    <div class="lane"><p><b>{{ lane.title }}</b>{{ lane.span }}</p>
      {% for a in lane.actions %}
      <div class="action"><span class="no">{{ a.n }}</span><strong>{{ a.r.title }}</strong>{{ cite(a.r.fact_ids) }}
        {% if a.r.first_step %}<span class="sub">First step: {{ a.r.first_step }}</span>{% elif a.r.rationale %}<span class="sub">{{ a.r.rationale }}</span>{% endif %}
        {% if a.r.owner or a.r.metric %}<span class="sub">{% if a.r.owner %}{{ a.r.owner }}{% endif %}{% if a.r.owner and a.r.metric %}, {% endif %}{% if a.r.metric %}measured by {{ a.r.metric }}{% endif %}</span>{% endif %}
        <div class="meta-line"><span class="chip prio-{{ a.r.priority }}">{{ a.r.priority | title }} priority</span><span>impact {{ [[a.r.impact, 1] | max, 5] | min }}, effort {{ [[a.r.effort, 1] | max, 5] | min }}</span>{% if a.kind == "Quick win" %}<span class="chip fm-yes">Quick win</span>{% endif %}</div>
      </div>
      {% else %}
      <p class="empty">Nothing planned here.</p>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {{ chart("impact_effort") }}
  {% if r.market.white_space %}<h3>Gaps no competitor serves well</h3>{{ insight_list(r.market.white_space) }}{% endif %}
</section>
{% endif %}

{% if show.risks %}
<section id="risks">
  <p class="eyebrow">Risks</p>
  <h2>Risks to watch</h2>
  {{ chart("risk_heatmap") }}
  <div class="table-wrap"><table>
    <thead><tr><th>Risk</th><th>Type</th><th>Score</th><th>What to do</th></tr></thead>
    <tbody>
    {% for item in risks %}
      <tr><td><strong>{{ item.label }}: {{ item.r.title }}</strong>{{ cite(item.r.fact_ids) }}{% if item.r.description %}<span class="sub">{{ item.r.description }}</span>{% endif %}</td><td class="nowrap">{{ item.category }}</td><td class="nowrap"><span class="chip band-{{ item.band }}">{{ item.score }} ({{ item.band }})</span><span class="sub">likelihood {{ item.likelihood }} × impact {{ item.impact }}</span></td><td>{{ item.r.mitigation }}{% if item.r.owner %}<span class="sub">Owner: {{ item.r.owner }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endif %}

{% if show.battlecards %}
<section id="battlecards">
  <p class="eyebrow">Sales</p>
  <h2>Battlecards</h2>
  {% for b in battlecards %}
  <h3><span class="dot" style="--c: {{ color(b.competitor) }}"></span>{{ display(b.competitor) }}</h3>
  {% if b.one_liner %}<p class="lede measure">{{ b.one_liner }}</p>{% endif %}
  <div class="pair">
    <div class="panel"><p class="label c-good">Why we win</p>{{ plain_list(b.why_we_win) }}</div>
    <div class="panel"><p class="label c-bad">Their strengths</p>{{ plain_list(b.their_strengths) }}</div>
    <div class="panel"><p class="label c-accent">Their weaknesses</p>{{ plain_list(b.their_weaknesses) }}</div>
    <div class="panel"><p class="label c-warn">Questions to ask the buyer</p>{{ plain_list(b.landmines) }}</div>
  </div>
  {% if b.objections %}
  <div class="table-wrap"><table>
    <thead><tr><th>When they say</th><th>Answer</th></tr></thead>
    <tbody>{% for o in b.objections %}<tr><td>"{{ o.objection }}"</td><td>{{ o.response }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
  {% if b.pricing_talk_track %}<p class="measure"><strong>On price:</strong> {{ b.pricing_talk_track }}</p>{% endif %}
  {% endfor %}
</section>
{% endif %}

{% if show.changes %}
<section id="changes">
  <p class="eyebrow">Since the last run</p>
  <h2>What changed</h2>
  {{ plain_list(r.changes_since_last_run) }}
</section>
{% endif %}

<section id="quality">
  <p class="eyebrow">Method</p>
  <h2>How this report was made</h2>
  {% if pipeline %}
  <ol class="pipeline" style="--n: {{ pipeline | length }}">{% for label, value in pipeline %}<li><b>{{ value | num }}</b><span>{{ label }}</span></li>{% endfor %}</ol>
  {% endif %}
  {% if r.methodology %}<p class="measure">{{ r.methodology }}</p>{% endif %}
  <div class="tiles">
    {% for m in quality_metrics %}<div class="tile"><b>{{ m.display }}</b><span>{{ m.label }}</span>{% if m.note %}<small>{{ m.note }}</small>{% endif %}</div>{% endfor %}
  </div>
  {{ chart("verification_funnel") }}
  {{ chart("coverage") }}
  {{ chart("evidence_mix") }}
  {% if r.reviews %}
  <h3>Quality reviews</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>Stage</th><th class="num">Score</th><th>Verdict</th><th>Issues raised</th></tr></thead>
    <tbody>
    {% for rv in r.reviews %}
      <tr><td>{{ rv.stage | replace("_", " ") | capitalize }} <span class="muted small">#{{ rv.attempt }}</span><span class="sub">{{ rv.reviewer }}</span></td><td class="num">{{ "%.1f" | format(rv.score) }}</td><td><span class="chip verdict-{{ rv.verdict }}">{{ rv.verdict | title }}</span></td><td class="small">{% for i in rv.issues %}<div>{{ i }}</div>{% else %}<span class="muted">None</span>{% endfor %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}
  {% if model_usage %}
  <h3>AI models used</h3>
  {{ chart("model_usage") }}
  <div class="table-wrap"><table>
    <thead><tr><th>Model</th><th class="num">Calls</th><th class="num">Failed</th><th class="num">From cache</th><th class="num">Tokens in</th><th class="num">Tokens out</th></tr></thead>
    <tbody>
    {% for u in model_usage %}
      <tr><td><span class="model">{{ u.model_id }}</span><span class="sub">{{ u.roles | join(", ") | replace("_", " ") }}</span></td><td class="num">{{ u.calls | num }}</td><td class="num">{{ u.failures | num }}</td><td class="num">{{ u.cache_hits | num }}</td><td class="num">{{ u.tokens_in | num }}</td><td class="num">{{ u.tokens_out | num }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}
  {% if departments %}
  <h3>The research team</h3>
  <div class="org">
    {% for dept, agents in departments.items() %}
    <div class="dept"><h4>{{ dept }}</h4>
      {% for a in agents %}<div class="agent"><strong>{{ a.title or a.key }}</strong><p>{{ a.mission }}</p>{% for m in a.models_used %}<span class="model">{{ m }}</span>{% endfor %}</div>{% endfor %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if r.lessons_applied %}
  <h3>Lessons from earlier runs</h3>
  <ul class="measure">{% for l in r.lessons_applied %}<li>{{ l.text }} <span class="small muted">({{ l.role | replace("_", " ") }})</span></li>{% endfor %}</ul>
  {% endif %}
</section>

{% if show.sources %}
<section id="sources">
  <p class="eyebrow">Appendix</p>
  <h2>Sources</h2>
  {% if source_split %}{{ split(source_split) }}{% endif %}
  <div class="table-wrap"><table>
    <thead><tr><th>Source</th><th>Type</th><th>Published</th><th class="num">Reliability</th><th class="num">Facts</th></tr></thead>
    <tbody>
    {% for item in sources %}
      <tr><td>{{ ext_link(item.url, item.s.title or item.s.domain or item.s.url) }}<span class="sub">{{ item.s.domain }}</span></td><td>{{ item.s.source_type | title }}</td><td class="nowrap">{{ item.s.published or "-" }}</td><td class="num">{{ item.s.reliability | pct }}</td><td class="num">{{ item.s.fact_count }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</section>
{% endif %}

<section id="facts">
  <p class="eyebrow">Appendix</p>
  <h2>Evidence</h2>
  <p class="muted measure">Every numbered citation in this report points to one of these facts: the claim, the exact sentence it came from, its sources, and how it was checked.</p>
  {% if status_split %}{{ split(status_split) }}{% endif %}
  {% if fact_rows %}
  <div class="filter"><label for="fact-filter" class="small muted">Find</label><input id="fact-filter" type="search" placeholder="A company, a claim or a status" autocomplete="off"></div>
  <div class="table-wrap"><table id="fact-table">
    <thead><tr><th>#</th><th>Claim</th><th>Check</th><th>Sources</th></tr></thead>
    <tbody>
    {% for row in fact_rows %}
      {% set f = row.f %}
      <tr class="fact-row" id="{{ row.anchor }}">
        <td class="nowrap"><span class="fact-no">{{ loop.index }}</span><span class="fact-id">{{ f.id | anchor }}</span></td>
        <td>{{ f.claim }}{% if f.value %} <span class="small muted">({{ f.value }})</span>{% endif %}<span class="sub">{{ display(f.competitor) }}, {{ row.dimension }}</span>{% if f.quote %}<blockquote>"{{ f.quote }}"</blockquote>{% endif %}{% if f.verification_notes %}<span class="sub">{{ f.verification_notes }}</span>{% endif %}</td>
        <td class="nowrap"><span class="chip st-{{ f.status }}">{{ row.status.glyph }} {{ row.status.label }}</span><span class="sub">{{ f.confidence | pct }} confidence{% if f.grounded %}, quote found{% endif %}</span>{% if f.corroborations %}<span class="sub">{{ f.corroborations }} other site{{ "s" if f.corroborations != 1 else "" }} agree</span>{% endif %}</td>
        <td class="src-links small">{% for url, label in row.links %}{{ ext_link(url, label, title=url) }}{% else %}<span class="muted">-</span>{% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p class="muted">No facts were recorded for this run.</p>
  {% endif %}
</section>

</main>
</div>
<footer class="page">Researched by Resurge's AI agents from public web pages. Every fact was matched to the sentence it came from and checked by a second AI model; mistakes are still possible, so confirm important figures before you rely on them. Not affiliated with the companies named. {{ generated }}.</footer>
</div>
<script>{{ inline_script }}</script>
</body>
</html>
