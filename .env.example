# --------------------------------------------------------------------------
# Resurge - FREE API keys. Add as many as you like: the router spreads work
# across all of them and fails over automatically. One key is enough to start.
# `resurge init` shows the sign-up links; `resurge doctor` checks them.
# --------------------------------------------------------------------------

# --- LLM providers (all have no-card free tiers) ---
GROQ_API_KEY=            # https://console.groq.com/keys        (fast; gpt-oss-120b, llama-3.3-70b, qwen3.8)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey   (Gemini 3.x Flash, Gemma 4; 1M context)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys           (Nemotron-3-Ultra 550B, Gemma 4 ... :free)
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys  (Mistral Large/Medium/Small free tier)
NVIDIA_API_KEY=          # https://build.nvidia.com             (~40 RPM dev access)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai            (trial credits)
CLOUDFLARE_API_TOKEN=    # https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
# OLLAMA_BASE_URL=http://localhost:11434   # local models: unlimited + private
# OLLAMA_NUM_CTX=16384

# --- Optional search upgrades (keyless search works out of the box) ---
TAVILY_API_KEY=          # 1,000 free credits / month
EXA_API_KEY=             # $10 free credits / month
JINA_API_KEY=            # 10M free tokens per key (search + reader)
SERPER_API_KEY=          # 2,500 free Google queries (one-time)
BRAVE_API_KEY=           # $5 monthly credit
SEARXNG_URL=             # self-hosted SearXNG, e.g. http://localhost:8888
GITHUB_TOKEN=            # raises GitHub API limits (60 -> 5,000 req/h)

# --- Optional publishing ---
GOOGLE_SERVICE_ACCOUNT_FILE=   # path to service-account JSON (Google Sheets export)
GOOGLE_SHEETS_SHARE_WITH=      # email to share the generated sheet with
GOOGLE_DRIVE_FOLDER_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
RESURGE_WEBHOOK_URL=

# --- Optional: RAG chat over finished runs (`resurge chat`, dashboard, MCP ask_research) ---
# Leave blank to use the embedded local Qdrant store under data/qdrant (free, private, offline).
QDRANT_URL=                     # Qdrant Cloud free 1 GB cluster URL (https://cloud.qdrant.io) - chunks + embeddings go there
QDRANT_API_KEY=                 # API key of that cluster
# RESURGE_EMBED_MODEL=BAAI/bge-small-en-v1.5   # local fastembed model (free, ~70 MB, downloaded once)
# RESURGE_QDRANT_MODE=auto      # auto | local | cloud  (local = ignore QDRANT_URL)

# --- Policy ---
# RESURGE_PRIVATE=1             # exclude providers whose free tier may train on prompts
# RESURGE_LOCAL_ONLY=1          # only local Ollama models
# RESURGE_PROVIDERS=groq,gemini # allow-list
# robots.txt is ALWAYS honoured (no switch). Polite crawling identity & policy:
RESURGE_CONTACT=                # URL or e-mail added to the ResurgeBot User-Agent (Wikimedia asks for one)
# RESURGE_EXTRA_NOFETCH_DOMAINS=example.com,other.com   # more sites never to fetch (see config/compliance.yaml)
# RESURGE_ALLOW_UNOFFICIAL_SEARCH=1   # opt-in: ddgs / Google News RSS (may conflict with those services' terms)
# RESURGE_LEARNING=1            # self-improvement loop (playbooks, model & source reputation)
